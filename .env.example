# RideSmart environment
# cp .env.example .env
#
# NOTE: SQLite is used for development because it needs zero setup and the
# demo has to start fast. To move to PostgreSQL, change DATABASE_URL only --
# the ORM models are portable and no schema change is required.
#
#   postgresql://ridesmart:ridesmart@db:5432/ridesmart

DATABASE_URL=sqlite:///./ridesmart.db

# Backend (Member 2 - database/ FastAPI app)
API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Member 3 - React). Must be prefixed with VITE_ to reach the browser.
VITE_API_URL=http://localhost:8000
# Leave blank to use the free OpenStreetMap raster tiles. Set only if you have a key.
VITE_MAP_TILE_URL=

# Simulator (Member 5 - simulation_ml/)
SIM_SPEED=5
SIM_INTERVAL=2
SIM_SEED=7

# CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173